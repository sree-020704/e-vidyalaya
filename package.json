{
  "name": "database",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema and database seeding scripts for e-Vidyalaya",
  "scripts": {
    "db:schema": "psql -U postgres -d evidyalaya -f schema.sql",
    "db:seed": "psql -U postgres -d evidyalaya -f seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed"
  },
  "keywords": [
    "postgresql",
    "schema",
    "seed"
  ],
  "author": "e-Vidyalaya Team",
  "dependencies": {
    "@nestjs/config": "^4.0.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0"
  }
}
